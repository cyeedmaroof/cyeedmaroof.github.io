---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import profile from "../../data/profile.json";
import projects from "../../data/projects.json";
---

<Layout
  title={`Projects — ${profile.name}`}
  description="Data science and machine-learning projects: energy forecasting, GenAI agents, reinforcement learning, and dashboards."
>
  <section class="section wrap">
    <div class="section-head">
      <p class="eyebrow">Projects</p>
      <h2>Case studies</h2>
      <p class="lead">
        Real work, honestly framed — problem, data, approach, and what I'd do
        next. Metrics still being gathered are flagged, never invented.
      </p>
    </div>
    <div class="card-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- website: Auroville Film Institute (embedded open, not a tile) -->
  <section class="section wrap">
    <div class="section-head">
      <p class="eyebrow">Website</p>
      <h2>Website I built for Auroville Film Institute</h2>
      <p class="lead">
        A live site I designed and built for the institute — its diploma
        programme, workshops and courses.
      </p>
    </div>
    <div class="demo-embed">
      <iframe
        src="https://filminstitute.auroville.org/"
        title="Auroville Film Institute — live site"
        loading="lazy"
      />
    </div>
    <p class="back-link" style="margin-top:0.6rem;">
      <a href="https://filminstitute.auroville.org/">Open in a new tab ↗</a>
    </p>
  </section>
</Layout>
